# LiveChat 3.0.0 — configuration du serveur Rust (lc-server)
# Copier vers `deploy/.env` puis renseigner les secrets. Ce fichier est un
# modèle : ne jamais y mettre de secret réel (voir `deploy/.gitignore`).
#
# Variables conservées du legacy (mêmes noms, mêmes valeurs par défaut) et
# ajouts Rust documentés dans docs/rust/migration-plan.md (annexe C).

# --- Réseau ----------------------------------------------------------------
PORT=3000
# Origine publique du serveur (obligatoire en production : CORS, URLs média).
API_URL=https://livechat.example.com
NODE_ENV=production
# Journalisation : RUST_LOG (EnvFilter) prioritaire, sinon LOG (info|debug|error|warning|silent).
RUST_LOG=info
# À activer uniquement derrière un reverse proxy qui pose X-Real-IP / X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- Admin -----------------------------------------------------------------
# Token du panel admin (vide = API admin désactivée, 503 admin_ui_disabled).
# AUD-COR-05 : le token ne s'accepte qu'en `Authorization: Bearer` (plus de
# `?token=` dans l'URL, y compris pour la page servie).
ADMIN_UI_TOKEN=
# true en production : l'API admin n'accepte que le loopback (défaut).
# En Docker (réseau bridge) le serveur voit l'IP de la passerelle, pas le
# loopback : garder true désactive de fait l'API admin. Pour utiliser le panneau,
# passer à false — il reste protégé par le bind 127.0.0.1 et ADMIN_UI_TOKEN.
# Voir docs/rust/packaging.md §10.
ADMIN_UI_LOCAL_ONLY=true

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
HIDE_COMMANDS_DISABLED=false
I18N=fr

# --- Base de données (SQLite) ---------------------------------------------
# Rust attend un DSN `sqlite://…` (image Docker : /app/data/livechat.sqlite).
# Ne JAMAIS pointer la base legacy Prisma (`sqlite.db` de server/).
DATABASE_URL=sqlite:///app/data/livechat.sqlite

# --- Lecture / média -------------------------------------------------------
DEFAULT_DURATION=5
PLAYBACK_JOB_RETENTION_HOURS=72
PAIRING_CODE_TTL_MINUTES=5
# Secret HMAC des URLs média signées : OBLIGATOIRE en production (vide = médias
# non servis). Générer : openssl rand -hex 32
MEDIA_URL_SECRET=
# TTL des URLs signées (secondes, borné par la spec protocole v2 : 300–3600).
MEDIA_URL_TTL_SEC=300
MIN_OVERLAY_VERSION=3.0.0
WS_HEARTBEAT_TIMEOUT_SEC=45
MEDIA_STORAGE_DIR=/app/data/media
MEDIA_CACHE_TTL_HOURS=12
MEDIA_CACHE_MAX_TOTAL_MB=5120
MEDIA_BOARD_MAX_TOTAL_MB=15360
MEDIA_MAX_CONCURRENT_INGESTIONS=2
MEDIA_DOWNLOAD_TIMEOUT_MS=180000
MEDIA_MAX_SIZE_MB=2048
MEDIA_VIDEO_MAX_HEIGHT=1080
MEDIA_VIDEO_ENCODER=auto
MEDIA_VIDEO_NVENC_PRESET=p4
MEDIA_VIDEO_PRESET=ultrafast
MEDIA_AUDIO_NORMALIZE_ENABLED=true
MEDIA_AUDIO_LOUDNORM_I=-18
MEDIA_AUDIO_LOUDNORM_LRA=11
MEDIA_AUDIO_LOUDNORM_TP=-1.5

# --- Sources / outillage externe ------------------------------------------
YTDLP_BINARY=yt-dlp
YTDLP_CONCURRENT_FRAGMENTS=1
YTDLP_FORMAT=bv*[vcodec^=avc1][ext=mp4][height<=1080]+ba[ext=m4a]/b[vcodec^=avc1][ext=mp4][height<=1080]/bv*[ext=mp4][height<=1080]+ba[ext=m4a]/b[ext=mp4][height<=1080]/bv*[height<=1080]+ba/b[height<=1080]/best
TIKTOK_COOKIE=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
TWITTER_OEMBED_ENDPOINT=https://publish.twitter.com/oembed
TWITTER_VIDEO_RESOLVER_BASE_URL=https://vxtwitter.com
TWITTER_CARD_DURATION_SEC=15

# --- CORS ------------------------------------------------------------------
# L'origine API_URL est toujours autorisée ; ajouter d'autres origines ici.
ADDITIONAL_CORS_ORIGINS=

# --- Ingest (legacy déprécié) ---------------------------------------------
# /ingest n'accepte que les tokens de clients créés via /admin ; laissé vide.
INGEST_API_TOKEN=
