    },
    {
      "id": "admin_guild_stop",
      "description": "POST /admin/api/guilds/:guildId/stop — guilde inconnue",
      "method": "POST",
      "path": "/admin/api/guilds/123456789012345678/stop",
      "auth": "admin",
      "status_alternatives": [200, 400, 404],
      "compare": {
