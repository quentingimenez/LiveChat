{
  "name": "livechat-monorepo",
  "private": true,
  "description": "LiveChat monorepo tooling: commit hooks and browser extension (MV3) scripts",
  "scripts": {
    "prepare": "husky",
    "extension:install": "npm --prefix extension install",
    "extension:build": "npm --prefix extension run build",
    "extension:check": "npm --prefix extension run ci:check"
  },
  "devDependencies": {
    "@commitlint/cli": "18.6.1",
    "@commitlint/config-conventional": "18.6.2",
    "husky": "9.0.11"
  }
}
