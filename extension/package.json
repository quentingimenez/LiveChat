{
  "name": "livechat-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','release']) fs.rmSync(p,{ recursive:true, force:true });\"",
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs --target=chromium",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:clean": "npm run clean && npm run build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "lint:amo": "npx --yes web-ext@8 lint --source-dir dist/firefox",
    "package": "python3 scripts/package.py",
    "release:build": "npm run build:clean && npm run verify:dist && npm run lint:amo && npm run package",
    "ci:check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:dist && npm run lint:amo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"vitest.config.ts\""
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^10.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "flatted": "^3.4.1",
    "rollup": "^4.59.0"
  }
}
