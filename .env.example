# Copie ce fichier en `.env` à la racine du dépôt et renseigne les valeurs de
# ton serveur. `.env` est ignoré par git (voir .gitignore) et n'est donc jamais
# versionné. scripts/release.ps1 le charge automatiquement ; une variable déjà
# définie dans l'environnement garde la priorité.
LIVECHAT_SSH_HOST=root@unraid.lan
LIVECHAT_PUBLIC_URL=https://livechat.example.com
