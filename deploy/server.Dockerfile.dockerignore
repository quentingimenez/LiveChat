# Minimal Docker context for deploy/server.Dockerfile (BuildKit).
# The repository is ~23 GB: target/ (18 GB), spikes/ (4.7 GB), legacy server/
# (350 MB), overlay/ (670 MB), extension/ (64 MB). Only the Rust workspace
# sources, the manifests and the Cargo configuration are sent to the builder.

.git
.github
.phase0
.cargo/registry
target
**/target
spikes
overlay
server
extension
docs
deploy

# Admin console: its sources are sent to the `admin-web` Vite stage, while
# installed dependencies and build output are always rebuilt inside the image.
apps/lc-admin-web/node_modules
apps/lc-admin-web/dist
node_modules
**/node_modules
dist
**/dist

build
**/build
data
**/data

# The legacy static/admin panel is gone: the console is embedded by rust-embed.
static

*.log
**/*.log
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-shm
**/*.db-wal
.env
.env.*
.vscode
.idea
