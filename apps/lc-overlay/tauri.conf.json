{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveChat",
  "version": "3.1.0",
  "identifier": "com.livechat",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "title": "LiveChat Overlay",
        "url": "overlay.html",
        "width": 1280,
        "height": 720,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "board",
        "title": "LiveChat — Board",
        "url": "board.html",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http: https:; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "LiveChat",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/quentingimenez/LiveChat/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdERjg2MTE3NDA1NDZERjAKUldUd2JWUkFGMkg0ZlVRY2ltWVBFMS94NnlLNlJnbk5rdm1Ta2J5UkJ2ZnZRUHg1N0tsZCtBZWwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
